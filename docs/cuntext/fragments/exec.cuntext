EXEC [run code in a stateful session]
deps=index.cuntext

# Session = persistent Python interpreter. State survives across calls.
# Templates: blank, data-science, machine-learning, web-scraping

session.create:
  POST /session/create
  body: {template?:str, ttl_seconds?:int, packages?:[str], checkpoint_id?:str}
  → {session_id:str, created_at:iso8601, expires_at:iso8601, workspace_path:str}

session.execute:
  POST /session/{session_id}/execute
  body: {code:str}
  → {stdout:str, result:any|null, error:str|null, plots:[str], html:str|null, duration_ms:int}
  note: result is typed JSON (int/float/list/dict). plots are base64 PNGs from plt.show()
  note: 423 if session is already executing

session.stream:
  POST /session/{session_id}/execute/stream
  body: {code:str}
  → SSE stream, final event has {type:"result", stdout, error?, duration_ms, plots, html?}

session.install:
  POST /session/{session_id}/install
  body: {packages:[str]}
  → {stdout:str, error:str|null, duration_ms:int}

session.status:
  GET /session/{session_id}/status
  → {active:bool, ttl_remaining:int, calls_used:int, session_id:str}

session.delete:
  DELETE /session/{session_id}
  → {deleted:true}

ex:
  POST /session/create {"template":"data-science"} → {"session_id":"abc123"}
  POST /session/abc123/execute {"code":"x = 40 + 2"} → {"result":42,"duration_ms":3}
  POST /session/abc123/execute {"code":"x * 2"} → {"result":84,"duration_ms":1}

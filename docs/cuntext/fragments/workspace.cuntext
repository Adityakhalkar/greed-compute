WORKSPACE [shared Python state across multiple agents]
deps=index.cuntext exec.cuntext

# Workspace = persistent, named Python session. Multiple API keys share one interpreter.
# State auto-saves after each execution. Survives runtime restarts.

workspace.create:
  POST /workspaces
  body: {name:str}
  → {id:str, name:str, owner_api_key:str, created_at:iso8601, live:bool}

workspace.list:
  GET /workspaces
  → [{id, name, owner_api_key, live, last_accessed_at}]

workspace.get:
  GET /workspaces/{id}
  → {id, name, owner_api_key, live, members:[{api_key, joined_at, is_owner}]}

workspace.execute:
  POST /workspaces/{id}/execute
  body: {code:str}
  → {stdout:str, result:any|null, error:str|null, duration_ms:int}
  note: serialized per workspace, concurrent calls queue safely

workspace.invite:
  POST /workspaces/{id}/invite
  body: {api_key:str}
  → {invited:str}
  note: owner only

workspace.kick:
  DELETE /workspaces/{id}/members/{api_key}
  → {removed:str}
  note: owner only

workspace.delete:
  DELETE /workspaces/{id}
  → 204
  note: owner only, kills runtime + deletes saved state

ex:
  POST /workspaces {"name":"research"} → {"id":"ws_abc"}
  POST /workspaces/ws_abc/execute {"code":"data = [1,2,3]"}
  POST /workspaces/ws_abc/invite {"api_key":"gc_other_key"}
  # other agent can now execute in the same workspace and see `data`
